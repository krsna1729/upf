From 65390920dd97f93c29e8fe7dff4c00e8c693e632 Mon Sep 17 00:00:00 2001
From: Saikrishna Edupuganti <6157640+krsna1729@users.noreply.github.com>
Date: Wed, 21 Oct 2026 10:30:21 +0530
Subject: [PATCH] firewall: a rule result record, written like a classifier
 result

---
 core/modules/firewall.cc  | 134 +++++++++++++++++++++++++++++++++++---
 core/modules/firewall.h   |  29 ++++++++-
 protobuf/module_msg.proto |   2 +
 3 files changed, 155 insertions(+), 10 deletions(-)

diff --git a/core/modules/firewall.cc b/core/modules/firewall.cc
index 6bd40230..6b94a373 100644
--- a/core/modules/firewall.cc
+++ b/core/modules/firewall.cc
@@ -13,6 +13,7 @@
 #include <string>
 #include <utility>
 
+#include "packet_reshape.h"
 #include "utils/ether.h"
 #include "utils/ip.h"
 #include "utils/logging.h"
@@ -100,9 +101,13 @@ std::vector<uint32_t> ActionIdsOf(
 
 CommandResponse Firewall::ParseRules(
     const bess::pb::FirewallArg &arg,
-    std::vector<bess::classifier::FirewallRule> *out) const {
+    std::vector<bess::classifier::FirewallRule> *out,
+    std::vector<std::string> *results) const {
   using bess::classifier::FirewallRule;
   out->clear();
+  if (results != nullptr) {
+    results->clear();
+  }
   int i = 0;
   for (const auto &rule : arg.rules()) {
     // "" is a wildcard (documented): the field matches any address of the
@@ -180,6 +185,16 @@ CommandResponse Firewall::ParseRules(
     }
     parsed.action = rule.drop() ? kDrop : kPass;
     parsed.action_id = rule.action_id();
+    if (results != nullptr) {
+      if (rule.result().size() > result_value_size_) {
+        return CommandFailure(
+            EINVAL, "rule %d: result is %zu bytes, the record is %zu", i,
+            rule.result().size(), result_value_size_);
+      }
+      std::string record = rule.result();
+      record.resize(result_value_size_, '\0');
+      results->push_back(std::move(record));
+    }
     out->push_back(parsed);
     i++;
   }
@@ -214,6 +229,42 @@ int Firewall::OnEvent(bess::Event event) {
                       "would); packets carry no action id";
     }
   }
+  result_plan_.reset();
+  if (!result_specs_.empty()) {
+    bess::classifier::RuntimeClassifierSchema schema;
+    // The result plan validates a key size even though it has no key side;
+    // the firewall's key is the packet's 5-tuple, not a classifier key.
+    schema.key_size = 1;
+    schema.value_size = result_value_size_;
+    schema.bounds = bess::classifier::BoundsPolicy::kCheck;
+    for (const ResultSpec &spec : result_specs_) {
+      bess::classifier::RuntimeResultField field;
+      field.value_offset = spec.value_offset;
+      field.size = spec.size;
+      if (spec.by_attr) {
+        const bess::metadata::mt_offset_t offset =
+            attr_offset(static_cast<size_t>(spec.attr_id));
+        if (!bess::metadata::IsValidOffset(offset)) {
+          LOG(ERROR) << "Firewall '" << name() << "': result field '"
+                     << spec.attr_name << "' has no metadata offset";
+          return -EINVAL;
+        }
+        field.destination = bess::classifier::BufferKind::kMetadata;
+        field.destination_offset = static_cast<size_t>(offset);
+      } else {
+        field.destination = bess::classifier::BufferKind::kPacket;
+        field.destination_offset = spec.offset;
+      }
+      schema.result_fields.push_back(std::move(field));
+    }
+    auto plan = bess::classifier::ResultPlan::Compile(schema);
+    if (!plan) {
+      LOG(ERROR) << "Firewall '" << name()
+                 << "': result plan: " << plan.error().message;
+      return -EINVAL;
+    }
+    result_plan_ = std::move(*plan);
+  }
   return 0;
 }
 
@@ -230,8 +281,43 @@ CommandResponse Firewall::Init(const bess::pb::FirewallArg &arg) {
   if (action_id_attr_ < 0) {
     return CommandFailure(-action_id_attr_, "add_metadata_attr() failed");
   }
+  result_specs_.clear();
+  result_value_size_ = 0;
+  for (const bess::pb::ResultField &field : arg.result_fields()) {
+    if (field.num_bytes() == 0) {
+      return CommandFailure(EINVAL, "a result field has zero bytes");
+    }
+    ResultSpec spec;
+    spec.value_offset = field.value_offset();
+    spec.size = field.num_bytes();
+    if (field.destination_case() == bess::pb::ResultField::kAttrName) {
+      if (field.attr_name().empty()) {
+        return CommandFailure(EINVAL, "a result field has an empty attribute");
+      }
+      spec.by_attr = true;
+      spec.attr_name = field.attr_name();
+      spec.attr_id = AddMetadataAttr(
+          spec.attr_name, spec.size,
+          bess::metadata::Attribute::AccessMode::kWrite);
+      if (spec.attr_id < 0) {
+        return CommandFailure(-spec.attr_id, "%s: add_metadata_attr failed",
+                              spec.attr_name.c_str());
+      }
+    } else if (field.destination_case() == bess::pb::ResultField::kOffset) {
+      spec.by_attr = false;
+      spec.offset = field.offset();
+    } else {
+      return CommandFailure(EINVAL,
+                            "a result field needs an attr_name or an offset");
+    }
+    result_value_size_ =
+        std::max(result_value_size_,
+                 static_cast<size_t>(spec.value_offset) + spec.size);
+    result_specs_.push_back(std::move(spec));
+  }
   std::vector<bess::classifier::FirewallRule> rules;
-  CommandResponse ret = ParseRules(arg, &rules);
+  std::vector<std::string> results;
+  CommandResponse ret = ParseRules(arg, &rules, &results);
   if (ret.has_error()) {
     return ret;
   }
@@ -241,7 +327,7 @@ CommandResponse Firewall::Init(const bess::pb::FirewallArg &arg) {
     return CommandFailure(EINVAL, "%s", table.error().c_str());
   }
   Install(std::make_unique<const Published>(
-      Published{std::move(*table), std::move(action_ids)}));
+      Published{std::move(*table), std::move(action_ids), std::move(results)}));
   arg_ = arg;
 
   // Stage builds the whole table (a refused rule refuses the transaction);
@@ -254,7 +340,8 @@ CommandResponse Firewall::Init(const bess::pb::FirewallArg &arg) {
       // NOLINTBEGIN(clang-analyzer-cplusplus.NewDeleteLeaks)
       [this](const bess::pb::FirewallArg &v) -> std::expected<Staged, std::string> {
         std::vector<bess::classifier::FirewallRule> parsed;
-        CommandResponse r = ParseRules(v, &parsed);
+        std::vector<std::string> results;
+        CommandResponse r = ParseRules(v, &parsed, &results);
         if (r.has_error()) {
           return std::unexpected(r.error().errmsg());
         }
@@ -265,7 +352,8 @@ CommandResponse Firewall::Init(const bess::pb::FirewallArg &arg) {
         }
         return Staged{
             std::make_unique<const Published>(
-                Published{std::move(*next), std::move(action_ids)}),
+                Published{std::move(*next), std::move(action_ids),
+                          std::move(results)}),
             v};
       },
       // NOLINTEND(clang-analyzer-cplusplus.NewDeleteLeaks)
@@ -490,9 +578,9 @@ void Firewall::ProcessBatch(Context *ctx, bess::PacketBatch *batch) {
   if (table != nullptr && n > 0) {
     // Rule ids only when the action is published: the write needs the matched
     // rule's ActionId, and rule_id is what names the rule (0 otherwise).
-    matched =
-        table->LookupBatch(keys.data(), n, matches.data(), publish_action) &
-        parseable;
+    matched = table->LookupBatch(keys.data(), n, matches.data(),
+                                 publish_action || result_plan_.has_value()) &
+              parseable;
   }
 
   for (size_t i = 0; i < n; i++) {
@@ -505,6 +593,36 @@ void Firewall::ProcessBatch(Context *ctx, bess::PacketBatch *batch) {
         _set_attr_with_offset<bess::utils::be32_t>(action_offset, pkt,
                                                    bess::utils::be32_t(id));
       }
+      if (result_plan_ && matches[i].rule_id > 0 &&
+          matches[i].rule_id <= published->results.size()) {
+        const std::string &record = published->results[matches[i].rule_id - 1];
+        if (result_plan_->required_packet_bytes() != 0) {
+          bess::PacketHandle handle = pkt.handle();
+          if (!bess::packet::EnsureWritable(handle)) {
+            DropPacket(ctx, pkt);
+            continue;
+          }
+          batch->handles()[i] = handle;
+          pkt = bess::PacketRef(handle);
+          if (pkt.data_len() < result_plan_->required_packet_bytes()) {
+            DropPacket(ctx, pkt);
+            continue;
+          }
+        }
+        const bess::classifier::DestinationView destination{
+            .packet = bess::classifier::MutableBytes(
+                pkt.head_data<std::byte *>(), pkt.data_len()),
+            .metadata = bess::classifier::MutableBytes(
+                reinterpret_cast<std::byte *>(pkt.metadata()), SNBUF_METADATA)};
+        if (!result_plan_->Apply(
+                bess::classifier::ConstBytes(
+                    reinterpret_cast<const std::byte *>(record.data()),
+                    record.size()),
+                destination)) {
+          DropPacket(ctx, pkt);
+          continue;
+        }
+      }
       EmitPacket(ctx, pkt, ctx->current_igate);
     } else {
       DropPacket(ctx, pkt);
diff --git a/core/modules/firewall.h b/core/modules/firewall.h
index acf04785..6b47625b 100644
--- a/core/modules/firewall.h
+++ b/core/modules/firewall.h
@@ -4,9 +4,12 @@
 #define BESS_MODULES_FIREWALL_H_
 
 #include <memory>
+#include <optional>
+#include <string>
 #include <vector>
 
 #include "classifier/firewall_table.h"
+#include "classifier/result_plan.h"
 #include "framework/singleton_resource.h"
 #include "module.h"
 #include "pb/module_msg.pb.h"
@@ -50,6 +53,10 @@ class Firewall final : public Module {
     // names the action a matching rule carries (D-141) without holding the
     // rule list itself.
     std::vector<uint32_t> action_ids;
+    // The result record of the rule with id k at index k - 1, zero-padded to
+    // the module's result size. Empty when the argument declares no
+    // result_fields.
+    std::vector<std::string> results;
   };
   // A "<name>/rules" value, converted: the table to publish and the
   // FirewallArg it came from (read back as given).
@@ -60,10 +67,22 @@ class Firewall final : public Module {
 
   // Validates and converts every rule of `arg`; nothing is kept on error.
   CommandResponse ParseRules(const bess::pb::FirewallArg &arg,
-                             std::vector<bess::classifier::FirewallRule> *out)
-      const;
+                             std::vector<bess::classifier::FirewallRule> *out,
+                             std::vector<std::string> *results) const;
   void Install(std::unique_ptr<const Published> published);
 
+  // One configured result field: where its bytes go, and the slice of the
+  // rule's result record they come from. The same shape WildcardMatch and
+  // ExactMatch use; metadata offsets are resolved at PreResume.
+  struct ResultSpec {
+    bool by_attr = true;
+    std::string attr_name;
+    int attr_id = -1;
+    uint32_t offset = 0;
+    uint32_t value_offset = 0;
+    uint32_t size = 0;
+  };
+
   // The packet's 5-tuple. False for a packet this table cannot judge: not IPv4
   // or IPv6, or a header it cannot read (a truncated one). A packet whose ports
   // are not in the frame - a non-first fragment, a transport behind more
@@ -89,6 +108,12 @@ class Firewall final : public Module {
   // reported. Kept at Init: arg_ is the resource's value and is replaced by a
   // rules update.
   bool action_attr_configured_ = false;
+  // The result_fields the module was created with, and the plan that writes
+  // them. The fields are fixed at Init (a rules update cannot change the
+  // metadata layout); the plan is rebuilt in PreResume, when offsets exist.
+  std::vector<ResultSpec> result_specs_;
+  size_t result_value_size_ = 0;
+  std::optional<bess::classifier::ResultPlan> result_plan_;
 };
 
 #endif  // BESS_MODULES_FIREWALL_H_
diff --git a/protobuf/module_msg.proto b/protobuf/module_msg.proto
index 836a2c76..87d529fa 100644
--- a/protobuf/module_msg.proto
+++ b/protobuf/module_msg.proto
@@ -440,9 +440,11 @@ message FirewallArg {
     optional uint32 dst_port_high = 7; /// Inclusive upper bound (default 65535).
     bool drop = 8;             /// Drop matching packets instead of forwarding.
     optional uint32 action_id = 9; /// The action id a matching packet carries, 0 for none. The packet path writes it into the packet's "action_id" metadata attribute for whatever module downstream reads it (D-141). A rule that drops cannot name one.
+    bytes result = 10; /// The rule's result record, placed by result_fields. Shorter than the record size: the rest is zeros. Longer: refused.
   }
   repeated Rule rules = 1; /// The policy, in order.
   string action_attr = 2; /// The metadata attribute a matching rule's action id is written to (default "action_id"). The reader must be configured with the same name; with no reader the packets carry no action id (PreResume reports it once).
+  repeated ResultField result_fields = 3; /// What a matching rule writes beyond its action id: each field's bytes come from the rule's result record. Empty: no result record.
 }
 
